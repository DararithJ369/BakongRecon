# BakongRecon Backend Configuration

# Server
PORT=3000

# Database
# Use SQLite for local development (default)
DATABASE_URL=sqlite:///./bakongrecon.db
# Or use PostgreSQL
# DATABASE_URL=postgresql://bakongrecon:bakongrecon@localhost:5432/bakongrecon

# Telegram Bot (python-telegram-bot) - required for bot replies in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Trusted Telegram bot usernames to scrape from in groups (comma-separated, without @)
TELEGRAM_TRUSTED_BOT_USERNAME=PayWayByABA_bot

# Telegram (Telethon) - required for historical scraping
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=your_phone_number
TELEGRAM_CHAT_ID=your_group_username_or_id
